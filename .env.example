# Minimax LLM (Anthropic-compatible API)
ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic/v1
ANTHROPIC_API_KEY=your_minimax_api_key_here
ANTHROPIC_MODEL=MiniMax-M2.7

# Brave Search API (https://api.search.brave.com — free tier available)
BRAVE_API_KEY=your_brave_api_key_here

# Langfuse — self-hosted or cloud (cloud.langfuse.com / us.cloud.langfuse.com)
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://your-langfuse-host:port

# OneMap API — obtain a token via POST https://www.onemap.gov.sg/api/auth/post/getToken
# Token is valid for 3 days. Update this value when it expires.
ONEMAP_TOKEN=your_onemap_jwt_token_here

# Redis — used by RedisStore (optional; activate by running `pnpm add ioredis`)
REDIS_URL=redis://localhost:6379
